    <bpmn2:startEvent id="StartEvent" name="Besoin de recrutement identifié" />
    <bpmn2:endEvent id="EndEvent" name="Recrutement terminé" />
    <bpmn2:userTask id="JustifierBesoin" name="Identifier et justifier le besoin de recrutement" />
    <bpmn2:userTask id="SoumettreDemande" name="Soumettre le besoin de recrutement à la Direction" />
    <bpmn2:userTask id="ExaminerDemande" name="Examiner le besoin de recrutement" />
    <bpmn2:userTask id="DefinirPoste" name="Définir la fiche poste" />
    <bpmn2:userTask id="RedigerOffre" name="Rédiger l&apos;offre d&apos;emploi" />
    <bpmn2:userTask id="PublierOffre" name="Publier l&apos;offre d&apos;emploi" />
    <bpmn2:userTask id="ConsulterOffres" name="Consulter les offres publiées" />
    <bpmn2:userTask id="SoumettreCandidature" name="Soumettre la candidature et le CV" />
    <bpmn2:userTask id="ExaminerCV" name="Examiner les candidatures et les CV" />
    <bpmn2:userTask id="PlanifierEntretienRH" name="Planifier l&apos;entretien téléphonique" />
    <bpmn2:userTask id="EntretienRH" name="Mener l&apos;entretien RH et saisir l&apos;évaluation" />
    <bpmn2:userTask id="PlanifierEntretienManager" name="Planifier l&apos;entretien avec le Manager" />
    <bpmn2:userTask id="EntretienTechnique" name="Évaluer les compétences techniques et métier" />
    <bpmn2:userTask id="ConsoliderEvaluations" name="Consolider les évaluations des candidats" />
    <bpmn2:userTask id="ValiderCandidat" name="Valider le candidat retenu" />
    <bpmn2:userTask id="EnvoyerProposition" name="Générer et envoyer la proposition d&apos;embauche" />
    <bpmn2:userTask id="FormalitesEmbauche" name="Préparer le contrat, le registre du personnel, la visite médicale et la CNSS" />
    <bpmn2:userTask id="PreparerArrivee" name="Préparer le dossier d&apos;arrivée, le livret et le planning" />
    <bpmn2:userTask id="DemanderAccesIT" name="Demander les accès et le matériel à l&apos;IT" />
    <bpmn2:userTask id="CreerAccesIT" name="Créer les comptes et préparer le matériel" />
    <bpmn2:userTask id="AccueilCollaborateur" name="Accueillir le collaborateur et remettre les documents et accès" />
    <bpmn2:userTask id="SuiviUnMois" name="Organiser le suivi d&apos;intégration à un mois" />
